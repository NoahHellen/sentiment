# Copy to .env and fill in. Never commit .env — it is gitignored.

# --- database (required) ---
DB_SERVER=your-server.database.windows.net
DB_PORT=1433
DB_NAME=your-database
DB_USER=your-user
DB_PASSWORD=change-me
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=yes
DB_TRUST_SERVER_CERTIFICATE=no

# --- enrichment ---
# "mock" needs no API key and is the default.
ENRICHER=mock
# MOCK_FAILURE_RATE=0.3      # inject transient LLM failures to exercise retries
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# --- worker ---
# Run the pipeline inside the API process. Set false when running
# `python -m services.run_worker` as a separate deployment.
RUN_WORKER_IN_APP=true
# FETCH_CONCURRENCY=20
# ENRICH_CONCURRENCY=5
# PER_HOST_CONCURRENCY=4
# MAX_ATTEMPTS=5
# ALLOW_PRIVATE_HOSTS=false  # only enable to fetch from a local test server

# --- api ---
# Comma-separated origins, or *. Set this to your GitHub Pages origin in prod.
CORS_ORIGINS=*
# RATE_LIMIT_WRITES_PER_WINDOW=10
# RATE_LIMIT_READS_PER_WINDOW=240
